import Practice.DomainTheory.Papers.LipschitzYonedaFinalTopology.FormalBallCompletionIso
import Practice.DomainTheory.Papers.LipschitzYonedaFinalTopology.CauchyWeightedSubnet

/-!
# Domain structure of the rounded-ideal completion

Rounded ideals form a continuous dcpo under inclusion.  Via `sigmaOrderIso`,
this gives the formal balls of `S(X,d)` directed suprema and continuity.  We
then derive standardness and Yoneda completeness from the definitions used
in this paper.
-/

set_option autoImplicit false
set_option linter.unnecessarySimpa false

open Set Function
open scoped NNReal ENNReal Topology

noncomputable section

universe u

namespace LipschitzYonedaFinalTopology
namespace QuasiMetric

variable {X : Type u} (d : QuasiMetric X)

namespace RoundedIdeal

/-- Union of a nonempty directed family of rounded ideals. -/
def directedUnion (S : Set d.RoundedIdeal) (hne : S.Nonempty)
    (hdir : DirectedOn (· ≤ ·) S) : d.RoundedIdeal where
  val := {p | ∃ A ∈ S, p ∈ A}
  property := by
    constructor
    · intro p q hq hpq
      rcases hq with ⟨A, hAS, hqA⟩
      exact ⟨A, hAS, RoundedIdeal.lower d A hqA hpq⟩
    · constructor
      · rcases hne with ⟨A, hAS⟩
        rcases RoundedIdeal.nonempty d A with ⟨p, hpA⟩
        exact ⟨p, A, hAS, hpA⟩
      · intro p hp q hq
        rcases hp with ⟨A, hAS, hpA⟩
        rcases hq with ⟨B, hBS, hqB⟩
        rcases hdir A hAS B hBS with ⟨C, hCS, hAC, hBC⟩
        rcases RoundedIdeal.directed d C (hAC hpA) (hBC hqB) with
          ⟨r, hrC, hpr, hqr⟩
        exact ⟨r, ⟨C, hCS, hrC⟩, hpr, hqr⟩

/-- The directed union is the least upper bound. -/
theorem directedUnion_isLUB (S : Set d.RoundedIdeal) (hne : S.Nonempty)
    (hdir : DirectedOn (· ≤ ·) S) :
    IsLUB S (directedUnion d S hne hdir) := by
  constructor
  · intro A hAS p hpA
    exact ⟨A, hAS, hpA⟩
  · intro B hB p hp
    rcases hp with ⟨A, hAS, hpA⟩
    exact hB hAS hpA

theorem exists_isLUB (S : Set d.RoundedIdeal) (hne : S.Nonempty)
    (hdir : DirectedOn (· ≤ ·) S) :
    ∃ A : d.RoundedIdeal, IsLUB S A :=
  ⟨directedUnion d S hne hdir, directedUnion_isLUB d S hne hdir⟩

/-- Way-below relation in the rounded-ideal inclusion order. -/
def WayBelow (A B : d.RoundedIdeal) : Prop :=
  ∀ {S : Set d.RoundedIdeal}, S.Nonempty → DirectedOn (· ≤ ·) S →
    ∀ {C : d.RoundedIdeal}, IsLUB S C → B ≤ C →
      ∃ I ∈ S, A ≤ I

theorem wayBelow_le {A B : d.RoundedIdeal} (hAB : WayBelow d A B) :
    A ≤ B := by
  let S : Set d.RoundedIdeal := {B}
  have hne : S.Nonempty := Set.singleton_nonempty B
  have hdir : DirectedOn (· ≤ ·) S := by
    intro x hx y hy
    have hxB : x = B := by simpa [S] using hx
    have hyB : y = B := by simpa [S] using hy
    subst x
    subst y
    exact ⟨B, by simp [S], le_rfl, le_rfl⟩
  have hsup : IsLUB S B := by simpa [S] using (isLUB_singleton : IsLUB {B} B)
  rcases hAB hne hdir hsup le_rfl with
    ⟨I, hI, hAI⟩
  have hIB : I = B := by simpa [S] using hI
  simpa [hIB] using hAI

/-- A principal ideal generated by a member of `B` is way below `B`. -/
theorem principal_wayBelow {p : d.FormalBall} {B : d.RoundedIdeal}
    (hpB : p ∈ B) : WayBelow d (principal d p) B := by
  intro S hne hdir C hsup hBC
  let U := directedUnion d S hne hdir
  have hU : IsLUB S U := directedUnion_isLUB d S hne hdir
  have hCU : C = U := hsup.unique hU
  have hpU : p ∈ U := by
    rw [← hCU]
    exact hBC hpB
  rcases hpU with ⟨I, hIS, hpI⟩
  refine ⟨I, hIS, ?_⟩
  intro q hqp
  exact RoundedIdeal.lower d I hpI hqp

/-- Principal ideals generated by members of `A`. -/
def principalFamily (A : d.RoundedIdeal) : Set d.RoundedIdeal :=
  {I | ∃ p ∈ A, I = principal d p}

theorem principalFamily_nonempty (A : d.RoundedIdeal) :
    (principalFamily d A).Nonempty := by
  rcases RoundedIdeal.nonempty d A with ⟨p, hp⟩
  exact ⟨principal d p, p, hp, rfl⟩

theorem principalFamily_directed (A : d.RoundedIdeal) :
    DirectedOn (· ≤ ·) (principalFamily d A) := by
  intro I hI J hJ
  rcases hI with ⟨p, hpA, rfl⟩
  rcases hJ with ⟨q, hqA, rfl⟩
  rcases RoundedIdeal.directed d A hpA hqA with ⟨r, hrA, hpr, hqr⟩
  refine ⟨principal d r, ⟨r, hrA, rfl⟩, ?_, ?_⟩
  · intro z hzp
    exact FormalBall.strictBelow_trans d hzp hpr
  · intro z hzq
    exact FormalBall.strictBelow_trans d hzq hqr

theorem principalFamily_isLUB (A : d.RoundedIdeal) :
    IsLUB (principalFamily d A) A := by
  constructor
  · intro I hI p hpI
    rcases hI with ⟨q, hqA, rfl⟩
    exact RoundedIdeal.lower d A hqA hpI
  · intro B hB p hpA
    rcases RoundedIdeal.directed d A hpA hpA with ⟨q, hqA, hpq, _⟩
    exact hB ⟨q, hqA, rfl⟩ hpq

end RoundedIdeal

namespace Completion

private theorem orderIso_image_isLUB
    (E : Ball d ≃o d.RoundedIdeal) {S : Set (Ball d)} {p : Ball d}
    (h : IsLUB S p) : IsLUB (E '' S) (E p) := by
  constructor
  · intro I hI
    rcases hI with ⟨q, hqS, rfl⟩
    exact E.monotone (h.1 hqS)
  · intro I hI
    rw [← E.apply_symm_apply I]
    apply E.monotone
    apply h.2
    intro q hqS
    have hq := E.symm.monotone (hI ⟨q, hqS, rfl⟩)
    rw [E.symm_apply_apply] at hq
    exact hq

private theorem orderIso_preimage_isLUB
    (E : Ball d ≃o d.RoundedIdeal) {S : Set d.RoundedIdeal}
    {A : d.RoundedIdeal} (h : IsLUB S A) :
    IsLUB (E.symm '' S) (E.symm A) := by
  constructor
  · intro p hp
    rcases hp with ⟨B, hBS, rfl⟩
    exact E.symm.monotone (h.1 hBS)
  · intro p hp
    have hAEp : A ≤ E p := by
      apply h.2
      intro B hBS
      have hpre : E.symm B ≤ p := hp ⟨B, hBS, rfl⟩
      simpa using E.monotone hpre
    simpa using E.symm.monotone hAEp

/-- Every directed set of formal balls of the completion has a supremum. -/
theorem ball_exists_isLUB (S : Set (Ball d)) (hne : S.Nonempty)
    (hdir : DirectedOn (· ≤ ·) S) :
    ∃ p : Ball d, IsLUB S p := by
  let E := sigmaOrderIso d
  have himage_ne : (E '' S).Nonempty := hne.image E
  have himage_dir : DirectedOn (· ≤ ·) (E '' S) := by
    rintro _ ⟨p, hpS, rfl⟩ _ ⟨q, hqS, rfl⟩
    rcases hdir p hpS q hqS with ⟨r, hrS, hpr, hqr⟩
    exact ⟨E r, ⟨r, hrS, rfl⟩, E.monotone hpr, E.monotone hqr⟩
  rcases RoundedIdeal.exists_isLUB d (E '' S) himage_ne himage_dir with
    ⟨A, hA⟩
  refine ⟨E.symm A, ?_⟩
  have hpre := orderIso_preimage_isLUB d E hA
  simpa using hpre

/-- The completion quasi-metric is standard because all directed formal-ball
families have suprema. -/
theorem isStandard : (quasiMetric d).IsStandard := by
  intro ι _ p hdir hmono t
  have hrange_ne : (Set.range p).Nonempty := by
    rcases hdir.1 with ⟨i⟩
    exact ⟨p i, i, rfl⟩
  have hrange_dir : DirectedOn (· ≤ ·) (Set.range p) := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    rcases hdir.2 i j with ⟨k, hik, hjk⟩
    exact ⟨p k, ⟨k, rfl⟩, hmono hik, hmono hjk⟩
  let pt : ι → Ball d := fun i ↦ FormalBall.shift (quasiMetric d) t (p i)
  have htrange_ne : (Set.range pt).Nonempty := by
    rcases hdir.1 with ⟨i⟩
    exact ⟨pt i, i, rfl⟩
  have htmono : Monotone pt := by
    intro i j hij
    exact (FormalBall.shift_le_shift_iff (quasiMetric d) t (p i) (p j)).2
      (hmono hij)
  have htrange_dir : DirectedOn (· ≤ ·) (Set.range pt) := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    rcases hdir.2 i j with ⟨k, hik, hjk⟩
    exact ⟨pt k, ⟨k, rfl⟩, htmono hik, htmono hjk⟩
  constructor
  · intro _hexists
    exact ball_exists_isLUB d (Set.range pt) htrange_ne htrange_dir
  · intro _hexists
    exact ball_exists_isLUB d (Set.range p) hrange_ne hrange_dir

/-- The completion is Yoneda-complete, derived from directed formal-ball
suprema and the weighted-subnet construction. -/
theorem isYonedaComplete : (quasiMetric d).IsYonedaComplete := by
  let dS := quasiMetric d
  have hstandard : dS.IsStandard := isStandard d
  intro ι _ x hdir hxCauchy
  let W := CauchyWeightedSubnet.ofCauchy dS x hdir hxCauchy
  let p : W.Index → dS.FormalBall := fun k ↦
    ⟨x (W.map k), W.radius k⟩
  have hpmono : Monotone p := W.formalBall_monotone
  have hpne : (Set.range p).Nonempty := by
    rcases W.directed.1 with ⟨k⟩
    exact ⟨p k, k, rfl⟩
  have hpdir : DirectedOn (· ≤ ·) (Set.range p) := by
    rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩
    rcases W.directed.2 i j with ⟨k, hik, hjk⟩
    exact ⟨p k, ⟨k, rfl⟩, hpmono hik, hpmono hjk⟩
  rcases ball_exists_isLUB d (Set.range p) hpne hpdir with ⟨q, hq⟩
  have hinf : sInf (Set.range fun k ↦ (p k).radius) = 0 := by
    apply le_antisymm
    · apply le_of_forall_pos_le_add
      intro ε hε
      obtain ⟨k, hk⟩ := W.radius_eventually_lt ε hε
      have hbdd : BddBelow (Set.range fun k ↦ (p k).radius) :=
        ⟨0, by intro r _; exact zero_le r⟩
      exact (csInf_le hbdd ⟨k, rfl⟩).trans (by
        simpa [p] using (hk k le_rfl).le)
    · exact zero_le _
  have hqrad : q.radius = 0 := by
    rw [IsStandard.radius_eq_iInf dS hstandard p W.directed hpmono hq]
    exact hinf
  have hq0 : IsLUB (Set.range p) (⟨q.center, 0⟩ : dS.FormalBall) := by
    have heq : q = (⟨q.center, 0⟩ : dS.FormalBall) := by
      cases q with
      | mk center radius =>
          rw [FormalBall.mk.injEq]
          exact ⟨rfl, hqrad⟩
    rw [← heq]
    exact hq
  have hsubLimit : dS.IsDLimit (fun k ↦ x (W.map k)) q.center :=
    IsStandard.center_isDLimit_of_zeroRadius_isLUB dS hstandard p
      W.directed hpmono q.center hq0
  refine ⟨q.center, ?_⟩
  intro y
  calc
    dS.edist q.center y =
        netLimsup (fun k ↦ dS.edist (x (W.map k)) y) := hsubLimit y
    _ = netLimsup (fun i ↦ dS.edist (x i) y) :=
      netLimsup_edist_comp_eq dS x W.directed hxCauchy W.map
        W.map_monotone W.map_cofinal y

private theorem formalBallWayBelow_of_idealWayBelow
    {A B : d.RoundedIdeal} (hAB : RoundedIdeal.WayBelow d A B) :
    (quasiMetric d).FormalBallWayBelow
      ((sigmaOrderIso d).symm A) ((sigmaOrderIso d).symm B) := by
  let E := sigmaOrderIso d
  intro S hne hdir p hsup hBp
  have himage_ne : (E '' S).Nonempty := hne.image E
  have himage_dir : DirectedOn (· ≤ ·) (E '' S) := by
    rintro _ ⟨x, hx, rfl⟩ _ ⟨y, hy, rfl⟩
    rcases hdir x hx y hy with ⟨z, hz, hxz, hyz⟩
    exact ⟨E z, ⟨z, hz, rfl⟩, E.monotone hxz, E.monotone hyz⟩
  have himage_sup : IsLUB (E '' S) (E p) :=
    orderIso_image_isLUB d E hsup
  have hBlep : B ≤ E p := by
    simpa [E] using E.monotone hBp
  rcases hAB himage_ne himage_dir himage_sup hBlep with
    ⟨I, hI, hAI⟩
  rcases hI with ⟨s, hsS, rfl⟩
  exact ⟨s, hsS, by simpa [E] using E.symm.monotone hAI⟩

private theorem fullWayBelow_of_basis
    (q : Ball d) (P : Set (Ball d))
    (hPne : P.Nonempty) (hPdir : DirectedOn (· ≤ ·) P)
    (hPsup : IsLUB P q)
    (hPsub : P ⊆ {p : Ball d | (quasiMetric d).FormalBallWayBelow p q}) :
    let W := {p : Ball d | (quasiMetric d).FormalBallWayBelow p q}
    W.Nonempty ∧ DirectedOn (· ≤ ·) W ∧ IsLUB W q := by
  let W := {p : Ball d | (quasiMetric d).FormalBallWayBelow p q}
  have hWne : W.Nonempty := hPne.mono hPsub
  have hWdir : DirectedOn (· ≤ ·) W := by
    intro a ha b hb
    rcases ha hPne hPdir hPsup le_rfl with ⟨pa, hpaP, hapa⟩
    rcases hb hPne hPdir hPsup le_rfl with ⟨pb, hpbP, hbpb⟩
    rcases hPdir pa hpaP pb hpbP with ⟨c, hcP, hpac, hpbc⟩
    exact ⟨c, hPsub hcP, hapa.trans hpac, hbpb.trans hpbc⟩
  have hWsup : IsLUB W q := by
    constructor
    · intro a ha
      let S : Set (Ball d) := {q}
      have hne : S.Nonempty := Set.singleton_nonempty q
      have hdir : DirectedOn (· ≤ ·) S := by
        intro x hx y hy
        have hxq : x = q := by simpa [S] using hx
        have hyq : y = q := by simpa [S] using hy
        subst x
        subst y
        exact ⟨q, by simp [S], le_rfl, le_rfl⟩
      have hsup : IsLUB S q := by
        simpa [S] using (isLUB_singleton : IsLUB {q} q)
      rcases ha hne hdir hsup le_rfl with ⟨z, hz, haz⟩
      have hzq : z = q := by simpa [S] using hz
      simpa [hzq] using haz
    · intro z hz
      exact hPsup.2 (fun p hp ↦ hz (hPsub hp))
  exact ⟨hWne, hWdir, hWsup⟩

/-- Formal balls of the completion form a continuous poset. -/
theorem formalBallPosetContinuous :
    (quasiMetric d).FormalBallPosetContinuous := by
  intro q
  let E := sigmaOrderIso d
  let PF := RoundedIdeal.principalFamily d (E q)
  let P : Set (Ball d) := E.symm '' PF
  have hPFne := RoundedIdeal.principalFamily_nonempty d (E q)
  have hPFdir := RoundedIdeal.principalFamily_directed d (E q)
  have hPFsup := RoundedIdeal.principalFamily_isLUB d (E q)
  have hPne : P.Nonempty := hPFne.image E.symm
  have hPdir : DirectedOn (· ≤ ·) P := by
    rintro _ ⟨A, hA, rfl⟩ _ ⟨B, hB, rfl⟩
    rcases hPFdir A hA B hB with ⟨C, hC, hAC, hBC⟩
    exact ⟨E.symm C, ⟨C, hC, rfl⟩,
      E.symm.monotone hAC, E.symm.monotone hBC⟩
  have hPsup : IsLUB P q := by
    have h := orderIso_preimage_isLUB d E hPFsup
    simpa [P, PF, E] using h
  have hPsub : P ⊆
      {p : Ball d | (quasiMetric d).FormalBallWayBelow p q} := by
    intro p hp
    rcases hp with ⟨I, hIPF, rfl⟩
    rcases hIPF with ⟨b, hbEq, rfl⟩
    have hway : RoundedIdeal.WayBelow d
        (RoundedIdeal.principal d b) (E q) :=
      RoundedIdeal.principal_wayBelow d hbEq
    change (quasiMetric d).FormalBallWayBelow
      ((sigmaOrderIso d).symm (RoundedIdeal.principal d b)) q
    intro S hSne hSdir a hSa hqa
    have htarget : (sigmaOrderIso d).symm (E q) ≤ a := by
      simpa [E] using hqa
    rcases (formalBallWayBelow_of_idealWayBelow d hway)
        hSne hSdir hSa htarget with ⟨s, hsS, hles⟩
    exact ⟨s, hsS, hles⟩
  exact fullWayBelow_of_basis d q P hPne hPdir hPsup hPsub

/-- The completion is continuous in the source-facing sense. -/
theorem isContinuous : (quasiMetric d).IsContinuous :=
  ⟨isStandard d, formalBallPosetContinuous d⟩

end Completion
end QuasiMetric
end LipschitzYonedaFinalTopology
