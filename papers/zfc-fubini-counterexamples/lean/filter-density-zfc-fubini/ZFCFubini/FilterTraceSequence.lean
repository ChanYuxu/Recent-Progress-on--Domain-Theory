import ZFCFubini.FilterTrace
import Mathlib.Topology.Homeomorph.Lemmas

/-!
The J and J_n sequence in the source proof of the FULL maximal trace theorem.
This file uses countable same-kernel approximation, not a replacement topology
generated by H_U. All implementation is new.
-/

set_option autoImplicit false
open Set Topology TopologicalSpace
open scoped Topology
universe u

namespace ZFCFubini.FilterDcpo
variable {X : Type u} [MetricSpace X] {M : Model X}

structure ShrinkingBase (p : Point M) where
  sets : ℕ → Set X
  mem : ∀ n, sets n ∈ p.filter
  antitone : Antitone sets
  cofinal : ∀ U ∈ p.filter, ∃ n, sets n ⊆ U
  in_ball : ∀ n, sets n ⊆ Metric.ball p.label (shrinkingRadius n)

noncomputable def shrinkingBase_of_countablyBased (p : Point M)
    (hcount : p.filter.CountablyBased) (hK : p.kernel = {p.label}) : ShrinkingBase p := by
  classical
  let a : ℕ → Set X := hcount.choose
  have ha : ∀ n, a n ∈ p.filter := hcount.choose_spec.1
  have hacof : ∀ U ∈ p.filter, ∃ n, a n ⊆ U := hcount.choose_spec.2
  let b : ℕ → Set X := fun n => (⋂ i ∈ Finset.range (n + 1), a i) ∩
    Metric.ball p.label (shrinkingRadius n)
  have hfin : ∀ S : Finset ℕ, (⋂ i ∈ S, a i) ∈ p.filter := by
    intro S
    induction S using Finset.induction_on with
    | empty => simpa using p.filter.univ_mem
    | @insert i S hiS ih =>
      rw [Finset.set_biInter_insert]
      exact p.filter.inter_mem (ha i) ih
  have hb : ∀ n, b n ∈ p.filter := by
    intro n
    apply p.filter.inter_mem (hfin _)
    apply p.ordinary_mem _ Metric.isOpen_ball
    change p.kernel ⊆ Metric.ball p.label (shrinkingRadius n)
    rw [hK]
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    exact Metric.mem_ball_self (shrinkingRadius_pos n)
  refine ⟨b, hb, ?_, ?_, fun _ => Set.inter_subset_right⟩
  · intro n m hnm y hy
    change y ∈ (⋂ i ∈ Finset.range (m + 1), a i) ∩ Metric.ball p.label (shrinkingRadius m) at hy
    refine ⟨?_, Metric.ball_subset_ball (shrinkingRadius_antitone hnm) hy.2⟩
    simp only [Set.mem_iInter]
    intro i hi
    exact Set.mem_iInter.mp (Set.mem_iInter.mp hy.1 i) (Finset.mem_range.mpr
      ((Finset.mem_range.mp hi).trans_le (Nat.add_le_add_right hnm 1)))
  · intro U hU
    obtain ⟨n, hn⟩ := hacof U hU
    refine ⟨n, ?_⟩
    intro y hy
    exact hn (Set.mem_iInter.mp (Set.mem_iInter.mp hy.1 n) (Finset.mem_range.mpr (Nat.lt_succ_self n)))

def sequenceTail (x : X) (z : ℕ → X) (n : ℕ) : Set X := insert x (z '' Set.Ici n)

theorem sequenceTail_nonempty (x : X) (z : ℕ → X) (n : ℕ) :
    (sequenceTail x z n).Nonempty := ⟨x, Set.mem_insert _ _⟩

theorem sequenceTail_antitone (x : X) (z : ℕ → X) : Antitone (sequenceTail x z) := by
  intro n m hnm
  exact Set.insert_subset_insert (Set.image_mono (Set.Ici_subset_Ici.mpr hnm))

theorem sequenceTail_countable (x : X) (z : ℕ → X) (n : ℕ) :
    (sequenceTail x z n).Countable := (Set.to_countable (Set.Ici n)).image z |>.insert x

theorem sequenceTail_zero (x : X) (z : ℕ → X) : sequenceTail x z 0 = insert x (Set.range z) := by
  have hI : (Set.Ici 0 : Set ℕ) = Set.univ := by ext n; simp
  rw [sequenceTail, hI, Set.image_univ]

theorem sequenceTail_compact {x : X} {z : ℕ → X} (hz : Filter.Tendsto z Filter.atTop (𝓝 x))
    (n : ℕ) : IsCompact (sequenceTail x z n) := by
  have hseq := hz.comp (Filter.tendsto_add_atTop_nat n)
  have hEq : Set.range (fun k => z (k + n)) = z '' Set.Ici n := by
    ext y
    constructor
    · rintro ⟨k, rfl⟩; exact ⟨k + n, Nat.le_add_left _ _, rfl⟩
    · rintro ⟨k, hk, rfl⟩
      refine ⟨k - n, ?_⟩
      change z (k - n + n) = z k
      rw [Nat.sub_add_cancel hk]
  simpa only [Function.comp_def, hEq, sequenceTail] using hseq.isCompact_insert_range

theorem sequenceTail_derived_subset {x : X} {z : ℕ → X}
    (hz : Filter.Tendsto z Filter.atTop (𝓝 x)) (n : ℕ) {y : X}
    (hy : AccPt y (Filter.principal (sequenceTail x z n))) : y = x := by
  by_contra hyx
  obtain ⟨U, V, hU, hV, hxU, hyV, hUV⟩ := t2_separation (fun hxy => hyx hxy.symm)
  have hevent : ∀ᶠ k in Filter.atTop, z k ∈ U := hz (hU.mem_nhds hxU)
  obtain ⟨k₀, hk₀⟩ := Filter.eventually_atTop.mp hevent
  have hfinite : (V ∩ sequenceTail x z n).Finite := by
    apply ((Finset.range k₀).finite_toSet.image z).subset
    rintro w ⟨hwV, hwC⟩
    rcases hwC with rfl | ⟨k, hk, rfl⟩
    · exact (Set.disjoint_left.mp hUV hxU hwV).elim
    · have hklt : k < k₀ := by
        by_contra h; exact Set.disjoint_left.mp hUV (hk₀ k (Nat.le_of_not_gt h)) hwV
      exact ⟨k, Finset.mem_range.mpr hklt, rfl⟩
  exact Set.Infinite.of_accPt (hy.nhds_inter (hV.mem_nhds hyV)) hfinite

theorem base_sequence_tendsto (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) : Filter.Tendsto z Filter.atTop (𝓝 p.label) := by
  apply Metric.tendsto_atTop.mpr
  intro r hr
  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hr
  refine ⟨n, ?_⟩
  intro m hnm
  exact (Metric.mem_ball.mp (a.in_ball m (hz m))).trans_le
    ((shrinkingRadius_antitone hnm).trans hn.le)

/-- The common intersection filter J = G ∩ ⋂ N_(z_n). -/
def traceIntersection (p : Point M) (z : ℕ → X) : OpenFilter M.tau :=
  OpenFilter.intersection (fun i : Option ℕ => i.elim p.filter (fun n => OpenFilter.nhds M.tau (z n)))

theorem traceIntersection_le (p : Point M) (z : ℕ → X) : traceIntersection p z ≤ p.filter :=
  fun _ hU => hU none

theorem traceIntersection_le_nhds (p : Point M) (z : ℕ → X) (n : ℕ) :
    traceIntersection p z ≤ OpenFilter.nhds M.tau (z n) := fun _ hU => hU (some n)

theorem traceIntersection_kernel (p : Point M) (hK : p.kernel = {p.label}) (z : ℕ → X) :
    (traceIntersection p z).kernel = sequenceTail p.label z 0 := by
  rw [traceIntersection, OpenFilter.kernel_intersection _ M.coSingleton_open, sequenceTail_zero]
  ext y
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨i, hi⟩
    cases i with
    | none =>
      change y ∈ p.kernel at hi
      rw [hK] at hi
      exact Or.inl hi
    | some n =>
      change y ∈ (OpenFilter.nhds M.tau (z n)).kernel at hi
      rw [M.kernel_nhds] at hi
      exact Or.inr ⟨n, (Set.mem_singleton_iff.mp hi).symm⟩
  · rintro (rfl | ⟨n, rfl⟩)
    · exact ⟨none, p.label_mem⟩
    · exact ⟨some n, OpenFilter.self_mem_kernel_nhds _⟩

def traceSequenceGenerators (p : Point M) (a : ShrinkingBase p) (z : ℕ → X) (n : ℕ) :
    Set (Set X) := (traceIntersection p z).sets ∪ {a.sets n} ∪
      {U | IsOpen U ∧ sequenceTail p.label z n ⊆ U}

theorem tail_subset_base (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) : sequenceTail p.label z n ⊆ a.sets n := by
  intro y hy
  rcases hy with rfl | ⟨m, hm, rfl⟩
  · exact p.label_mem _ (a.mem n)
  · exact a.antitone hm (hz m)

theorem traceSequenceGenerators_contain_tail (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) :
    ∀ U ∈ traceSequenceGenerators p a z n, sequenceTail p.label z n ⊆ U := by
  intro U hU y hy
  rcases hU with (hJ | hbase) | hOrd
  · rcases hy with rfl | ⟨m, hm, rfl⟩
    · exact p.label_mem U (traceIntersection_le p z hJ)
    · exact (traceIntersection_le_nhds p z m hJ).2
  · exact (Set.mem_singleton_iff.mp hbase) ▸ tail_subset_base p a z hz n hy
  · exact hOrd.2 hy

theorem traceSequenceGenerators_open (p : Point M) (a : ShrinkingBase p) (z : ℕ → X) (n : ℕ) :
    ∀ U ∈ traceSequenceGenerators p a z n, @IsOpen X M.tau U := by
  intro U hU
  rcases hU with (hJ | hbase) | hOrd
  · exact (traceIntersection p z).isOpen U hJ
  · exact (Set.mem_singleton_iff.mp hbase) ▸ p.filter.isOpen _ (a.mem n)
  · exact M.ordinary_le _ hOrd.1

/-- The source's J_n is the generated filter of J, a_n and ALL ordinary
neighbourhoods of the convergent-sequence tail C_n. -/
noncomputable def traceSequenceFilter (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) : OpenFilter M.tau :=
  OpenFilter.generated (traceSequenceGenerators p a z n) (traceSequenceGenerators_open p a z n)
    p.label (fun U hU => traceSequenceGenerators_contain_tail p a z hz n U hU (Set.mem_insert _ _))

theorem generator_mem_traceSequenceFilter (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) {U : Set X}
    (hU : U ∈ traceSequenceGenerators p a z n) : U ∈ traceSequenceFilter p a z hz n := by
  unfold traceSequenceFilter
  exact OpenFilter.generator_mem _ _ _ _ hU

theorem traceSequenceFilter_kernel (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) :
    (traceSequenceFilter p a z hz n).kernel = sequenceTail p.label z n := by
  apply Set.Subset.antisymm
  · intro y hy
    by_contra hyC
    have hGen : ({y}ᶜ : Set X) ∈ traceSequenceGenerators p a z n :=
      Or.inr ⟨isClosed_singleton.isOpen_compl,
        fun w hw hwy => hyC ((Set.mem_singleton_iff.mp hwy) ▸ hw)⟩
    exact (hy _ (generator_mem_traceSequenceFilter p a z hz n hGen)) (by simp)
  · intro y hy U hU
    obtain ⟨_, S, hS, hSU⟩ := hU
    apply hSU
    simp only [Set.mem_iInter]
    exact fun V hV => traceSequenceGenerators_contain_tail p a z hz n V (hS V hV) hy

theorem traceSequenceFilter_le (p : Point M) (hK : p.kernel = {p.label})
    (a : ShrinkingBase p) (z : ℕ → X) (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) :
    traceSequenceFilter p a z hz n ≤ p.filter := by
  apply OpenFilter.generated_le
  intro U hU
  rcases hU with (hJ | hbase) | hOrd
  · exact traceIntersection_le p z hJ
  · exact (Set.mem_singleton_iff.mp hbase) ▸ a.mem n
  · apply p.ordinary_mem _ hOrd.1
    change p.kernel ⊆ U
    rw [hK]
    intro y hy
    rw [Set.mem_singleton_iff.mp hy]
    exact hOrd.2 (Set.mem_insert _ _)

noncomputable def traceSequencePoint (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) : Point M where
  filter := traceSequenceFilter p a z hz n
  label := p.label
  kernel_nonempty := by rw [traceSequenceFilter_kernel]; exact sequenceTail_nonempty _ _ _
  kernel_countable := by rw [traceSequenceFilter_kernel]; exact sequenceTail_countable _ _ _
  kernel_compact := by rw [traceSequenceFilter_kernel]; exact sequenceTail_compact (base_sequence_tendsto p a z hz) n
  label_mem := by rw [traceSequenceFilter_kernel]; exact Set.mem_insert _ _
  derived_subset := by
    intro y hy
    rw [traceSequenceFilter_kernel] at hy
    exact sequenceTail_derived_subset (base_sequence_tendsto p a z hz) n hy
  ordinary_mem := by
    intro U hU hKU
    rw [traceSequenceFilter_kernel] at hKU
    exact generator_mem_traceSequenceFilter p a z hz n (Or.inr ⟨hU, hKU⟩)

theorem traceSequencePoint_mono (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) : Monotone (traceSequencePoint p a z hz) := by
  intro n m hnm
  refine Or.inl ⟨rfl, ?_⟩
  change traceSequenceFilter p a z hz n ≤ traceSequenceFilter p a z hz m
  unfold traceSequenceFilter
  apply OpenFilter.generated_le
  intro U hU
  rcases hU with (hJ | hbase) | hOrd
  · exact generator_mem_traceSequenceFilter p a z hz m (Or.inl (Or.inl hJ))
  · rw [Set.mem_singleton_iff.mp hbase]
    apply (traceSequenceFilter p a z hz m).upward
      (generator_mem_traceSequenceFilter p a z hz m (Or.inl (Or.inr rfl)))
      (p.filter.isOpen _ (a.mem n)) (a.antitone hnm)
  · exact generator_mem_traceSequenceFilter p a z hz m (Or.inr
      ⟨hOrd.1, (sequenceTail_antitone p.label z hnm).trans hOrd.2⟩)

theorem traceSequencePoint_directed (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) : Directed (· ≤ ·) (traceSequencePoint p a z hz) := by
  intro n m
  exact ⟨max n m, traceSequencePoint_mono p a z hz (le_max_left _ _),
    traceSequencePoint_mono p a z hz (le_max_right _ _)⟩

theorem traceSequencePoint_le (p : Point M) (hK : p.kernel = {p.label})
    (a : ShrinkingBase p) (z : ℕ → X) (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) :
    traceSequencePoint p a z hz n ≤ p := Or.inl ⟨rfl, traceSequenceFilter_le p hK a z hz n⟩

theorem traceSequencePoint_le_e (p : Point M) (a : ShrinkingBase p) (z : ℕ → X)
    (hz : ∀ n, z n ∈ a.sets n) (n : ℕ) : traceSequencePoint p a z hz n ≤ e M (z n) := by
  apply (le_e_iff _ _).mpr
  change z n ∈ (traceSequenceFilter p a z hz n).kernel
  rw [traceSequenceFilter_kernel]
  exact Or.inr ⟨n, Set.mem_Ici.mpr (Nat.le_refl n), rfl⟩

/-- The J_n sequence has actual union filter G and supremum (G,x). -/
theorem traceSequencePoint_isLUB (p : Point M) (hK : p.kernel = {p.label})
    (a : ShrinkingBase p) (z : ℕ → X) (hz : ∀ n, z n ∈ a.sets n) :
    IsLUB (Set.range (traceSequencePoint p a z hz)) p := by
  constructor
  · rintro _ ⟨n, rfl⟩; exact traceSequencePoint_le p hK a z hz n
  · intro q hq
    have hF : p.filter ≤ q.filter := by
      intro U hU
      obtain ⟨n, hn⟩ := a.cofinal U hU
      have han : a.sets n ∈ (traceSequencePoint p a z hz n).filter :=
        generator_mem_traceSequenceFilter p a z hz n (Or.inl (Or.inr rfl))
      exact q.filter.upward (Point.filter_mono (hq (Set.mem_range_self n)) han) (p.filter.isOpen _ hU) hn
    by_cases he : p.label = q.label
    · exact Or.inl ⟨he, hF⟩
    · have hb := hq (Set.mem_range_self 0)
      rcases hb with ⟨h, _⟩ | ⟨h, _⟩
      · exact (he h).elim
      · exact Or.inr ⟨h, hF⟩

/-- Full source trace theorem: EVERY intrinsic Scott-open has a finer-open
maximal trace. The contradiction is the printed J_n sequence, not a basis-only
or ordinary-topology surrogate. -/
theorem trace_isOpen {M : Model X} (U : ScottOpens (Point M)) : M.tau.IsOpen (trace U) := by
  classical
  apply (@isOpen_iff_forall_mem_open X M.tau (trace U)).mpr
  intro x hx
  have hScott := (scott_isOpen_iff {p : Point M | WithScott.toScott p ∈ U}).mp U.isOpen
  obtain ⟨p, hpRange, hpU⟩ := hScott.2 (Set.range_nonempty (finiteApprox (e M x)))
    (finiteApprox_directed (e M x)).directedOn_range (finiteApprox_isLUB (e M x)) hx
  obtain ⟨S, rfl⟩ := hpRange
  let p := finiteApprox (e M x) S
  have hpcount : p.filter.CountablyBased := finiteApproxFilter_countablyBased (e M x) S
  have hpK : p.kernel = {p.label} := by
    rw [finiteApprox_kernel, kernel_e]; rfl
  let a := shrinkingBase_of_countablyBased p hpcount hpK
  have hxbase : ∀ n, x ∈ a.sets n := fun n => p.label_mem _ (a.mem n)
  have hex : ∃ n, a.sets n ⊆ trace U := by
    by_contra h
    have hbad : ∀ n, ∃ z ∈ a.sets n, z ∉ trace U := by
      simpa only [not_exists, Set.not_subset] using h
    choose z hz hzbad using hbad
    obtain ⟨q, hqRange, hqU⟩ := hScott.2 (Set.range_nonempty (traceSequencePoint p a z hz))
      (traceSequencePoint_directed p a z hz).directedOn_range
      (traceSequencePoint_isLUB p hpK a z hz) hpU
    obtain ⟨n, rfl⟩ := hqRange
    exact hzbad n (hScott.1 (traceSequencePoint_le_e p a z hz n) hqU)
  obtain ⟨n, hn⟩ := hex
  exact ⟨a.sets n, hn, p.filter.isOpen _ (a.mem n), hxbase n⟩

theorem e_continuous (M : Model X) :
    @Continuous X (WithScott (Point M)) M.tau inferInstance
      (fun y => WithScott.toScott (e M y)) := by
  rw [continuous_def]
  intro U hU
  exact trace_isOpen (⟨U, hU⟩ : ScottOpens (Point M))

/-- The reverse topological direction is supplied by the specified H_U opens. -/
theorem e_isEmbedding (M : Model X) :
    @Topology.IsEmbedding X (WithScott (Point M)) M.tau inferInstance
      (fun y => WithScott.toScott (e M y)) := by
  letI : TopologicalSpace X := M.tau
  refine ⟨⟨?_⟩, fun x y h => e_injective M (WithScott.toScott_inj.mp h)⟩
  apply TopologicalSpace.ext
  funext S
  apply propext
  rw [isOpen_induced_iff]
  constructor
  · intro hS
    let V : @Opens X M.tau := ⟨S, hS⟩
    exact ⟨(H M V : Set (WithScott (Point M))), (H M V).isOpen, trace_H M V⟩
  · rintro ⟨U, hU, rfl⟩
    exact trace_isOpen (⟨U, hU⟩ : ScottOpens (Point M))

def maximalSet (M : Model X) : Set (WithScott (Point M)) :=
  {p | ∀ q : Point M, WithScott.ofScott p ≤ q → q = WithScott.ofScott p}

theorem e_range_maximalSet (M : Model X) :
    Set.range (fun y => WithScott.toScott (e M y)) = maximalSet M := by
  ext p
  constructor
  · rintro ⟨y, rfl⟩
    exact (maximal_iff (e M y)).mpr ⟨y, rfl⟩
  · intro hp
    obtain ⟨y, hy⟩ := (maximal_iff (WithScott.ofScott p)).mp hp
    exact ⟨y, WithScott.ofScott_inj.mp hy.symm⟩

/-- Source-facing homeomorphism onto the ACTUAL maximal-point subspace.
Its forward function is definitionally the specified e. -/
noncomputable def maximalHomeomorph (M : Model X) :
    @Homeomorph X (maximalSet M) M.tau inferInstance := by
  letI : TopologicalSpace X := M.tau
  exact (e_isEmbedding M).toHomeomorph.trans (Homeomorph.setCongr (e_range_maximalSet M))

@[simp] theorem maximalHomeomorph_apply (M : Model X) (x : X) :
    (maximalHomeomorph M x).val = WithScott.toScott (e M x) := rfl

end ZFCFubini.FilterDcpo
