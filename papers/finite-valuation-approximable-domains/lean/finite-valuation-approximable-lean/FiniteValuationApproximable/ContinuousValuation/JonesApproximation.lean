import FiniteValuationApproximable.ContinuousValuation.JonesDissectionMass

/-!
# Finite atomic Jones approximations

The refined dissection is packaged as a genuine finite atomic valuation.  Its
total mass is at most one, and every finite subfamily of its atoms satisfies
the uniform Jones bound by the source valuation on the union of the
corresponding way-above opens.  This bound is the key finite compactness
certificate used both for domination and for the way-below proof.
-/

set_option autoImplicit false
set_option linter.unnecessarySimpa false
set_option maxHeartbeats 800000

universe u

namespace FiniteValuationApproximable
namespace ContinuousValuation

open Set
open AbramskyJung.Chapter2
open scoped ENNReal BigOperators

theorem refinedAtomicPoint_originalPattern
    {D : Type u} [Preorder D] [Nonempty D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1)
    (q : MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1))
    (hq : IsChosenRefinedPattern hD mu O t ht0 ht1 q) :
    membershipSignature O
        (refinedAtomicPoint hD mu O t ht0 ht1 q) =
      refinedOriginalPattern q := by
  classical
  let j := Classical.choose hq
  have hj := Classical.choose_spec hq
  have hpoint : refinedAtomicPoint hD mu O t ht0 ht1 q =
      jonesSupportPoint hD mu O t ht0 ht1 j := by
    simp [refinedAtomicPoint, hq, j]
  rw [hpoint]
  exact (chosenCellCover_mem_pattern hD mu O t ht0 ht1
    j.1 j.2.2).trans hj.1

theorem refinedAtomicWeight_le_signature
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1)
    (q : MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1)) :
    letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
    letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
    refinedAtomicWeight hD mu O t ht0 ht1 q ≤
      signatureVector mu (refinedOpenFamily hD mu O t ht0 ht1) q := by
  classical
  letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
  letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
  unfold refinedAtomicWeight
  split_ifs
  · exact mul_le_of_le_one_left
      ((signatureVector mu
        (refinedOpenFamily hD mu O t ht0 ht1)).coeff_nonneg q)
      (le_of_lt ht1)
  · exact (signatureVector mu
      (refinedOpenFamily hD mu O t ht0 ht1)).coeff_nonneg q

theorem refinedAtomicWeight_total_le_one
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1) :
    letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
    letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
    (∑ q : MembershipPattern
        (I ⊕ JonesSupport hD mu O t ht0 ht1),
      refinedAtomicWeight hD mu O t ht0 ht1 q) ≤ 1 := by
  classical
  letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
  letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
  calc
    (∑ q : MembershipPattern
        (I ⊕ JonesSupport hD mu O t ht0 ht1),
      refinedAtomicWeight hD mu O t ht0 ht1 q) ≤
        ∑ q, signatureVector mu
          (refinedOpenFamily hD mu O t ht0 ht1) q :=
      Finset.sum_le_sum fun q _ =>
        refinedAtomicWeight_le_signature hD mu O t ht0 ht1 q
    _ = (signatureVector mu
          (refinedOpenFamily hD mu O t ht0 ht1)).totalMass := by
      rfl
    _ ≤ 1 := (signatureVector mu
      (refinedOpenFamily hD mu O t ht0 ht1)).total_le_one

/-- The finite atomic valuation produced by the refined dissection. -/
noncomputable def refinedAtomicVSub
    {D : Type u} [Preorder D] [Nonempty D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1) : VSub D := by
  classical
  letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
  letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
  exact finiteAtomicVSub
    (refinedAtomicPoint hD mu O t ht0 ht1)
    (refinedAtomicWeight hD mu O t ht0 ht1)
    (refinedAtomicWeight_nonneg hD mu O t ht0 ht1)
    (refinedAtomicWeight_total_le_one hD mu O t ht0 ht1)

/-- Upper set generated by the support coordinates chosen by valid refined
patterns belonging to `K`. -/
noncomputable def chosenPatternUpper
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1)
    (K : Finset (MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1))) :
    UpperSet (MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1)) where
  carrier := {z | ∃ q ∈ K,
    ∃ hq : IsChosenRefinedPattern hD mu O t ht0 ht1 q,
      z (Sum.inr (Classical.choose hq)) = true}
  upper' := by
    intro z z' hzz' hz
    rcases hz with ⟨q, hqK, hq, hzq⟩
    have hle := hzz' (Sum.inr (Classical.choose hq))
    have htrue : true ≤ z' (Sum.inr (Classical.choose hq)) := by
      simpa only [hzq] using hle
    exact ⟨q, hqK, hq, Bool.eq_true_of_true_le htrue⟩

/-- Preimage of `chosenPatternUpper` is contained in the finite union of the
way-above opens attached to the atomic points indexed by `K`. -/
theorem chosenPatternUpper_preimage_le
    {D : Type u} [Preorder D] [Nonempty D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1)
    (K : Finset (MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1))) :
    letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
    letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
    ScottOpen.preimage
        (membershipSignatureMap (refinedOpenFamily hD mu O t ht0 ht1))
        (membershipSignatureMap
          (refinedOpenFamily hD mu O t ht0 ht1)).continuous
        (upperSetToScottOpen
          (chosenPatternUpper hD mu O t ht0 ht1 K)) ≤
      finiteUnion
        (fun q => wayAboveOpen hD
          (refinedAtomicPoint hD mu O t ht0 ht1 q)) K := by
  classical
  letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
  letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
  intro x hx
  change ∃ q ∈ K,
      ∃ hq : IsChosenRefinedPattern hD mu O t ht0 ht1 q,
        membershipSignature (refinedOpenFamily hD mu O t ht0 ht1) x
          (Sum.inr (Classical.choose hq)) = true at hx
  rcases hx with ⟨q, hqK, hq, hxq⟩
  apply (mem_finiteUnion_iff
    (fun q => wayAboveOpen hD
      (refinedAtomicPoint hD mu O t ht0 ht1 q)) K x).mpr
  refine ⟨q, hqK, ?_⟩
  have hopen : x ∈ jonesSupportOpen hD mu O t ht0 ht1
      (Classical.choose hq) :=
    (membershipSignature_apply_eq_true
      (refinedOpenFamily hD mu O t ht0 ht1) x
      (Sum.inr (Classical.choose hq))).mp hxq
  simpa [refinedAtomicPoint, hq] using hopen

/-- Finite-sum presentation of mass restricted to a finite set and a
predicate. -/
theorem sum_finset_ite_eq_vector_mass
    {Q : Type u} [Fintype Q]
    (v : SubprobabilityVector Q) (K : Finset Q) (P : Q → Prop)
    [DecidablePred P] :
    (∑ q ∈ K, if P q then v q else 0) =
      v.mass {q | q ∈ K ∧ P q} := by
  classical
  calc
    (∑ q ∈ K, if P q then v q else 0) =
        ∑ q ∈ K.filter P, v q := by
      rw [Finset.sum_filter]
    _ = ∑ q ∈ Finset.univ.filter (fun q => q ∈ K ∧ P q), v q := by
      apply Finset.sum_congr
      · ext q
        simp [and_comm]
      · intro q hq
        rfl
    _ = v.mass {q | q ∈ K ∧ P q} := by
      unfold SubprobabilityVector.mass
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro q hq
      simp

/-- Uniform finite-subfamily bound for the refined atomic weights. -/
theorem refinedAtomic_subset_bound
    {D : Type u} [Preorder D] [Nonempty D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type u} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (t : ℝ) (ht0 : 0 ≤ t) (ht1 : t < 1)
    (K : Finset (MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1))) :
    letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
    letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
    (∑ q ∈ K, refinedAtomicWeight hD mu O t ht0 ht1 q) ≤
      t * (mu (finiteUnion
        (fun q => wayAboveOpen hD
          (refinedAtomicPoint hD mu O t ht0 ht1 q)) K)).toReal := by
  classical
  letI : Fintype (JonesSupport hD mu O t ht0 ht1) := Fintype.ofFinite _
  letI : DecidableEq (JonesSupport hD mu O t ht0 ht1) := Classical.decEq _
  let v := signatureVector mu (refinedOpenFamily hD mu O t ht0 ht1)
  let P : MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1) → Prop :=
    IsChosenRefinedPattern hD mu O t ht0 ht1
  let S : Set (MembershipPattern
      (I ⊕ JonesSupport hD mu O t ht0 ht1)) :=
    {q | q ∈ K ∧ P q}
  let U := chosenPatternUpper hD mu O t ht0 ht1 K
  have hSU : S ⊆ (U : Set _) := by
    intro q hq
    exact ⟨q, hq.1, hq.2,
      (Classical.choose_spec hq.2).2⟩
  have hraw : v.mass S ≤
      (mu (finiteUnion
        (fun q => wayAboveOpen hD
          (refinedAtomicPoint hD mu O t ht0 ht1 q)) K)).toReal := by
    calc
      v.mass S ≤ v.mass (U : Set _) := v.mass_mono hSU
      _ = (mu (ScottOpen.preimage
          (membershipSignatureMap (refinedOpenFamily hD mu O t ht0 ht1))
          (membershipSignatureMap
            (refinedOpenFamily hD mu O t ht0 ht1)).continuous
          (upperSetToScottOpen U))).toReal :=
        signatureVector_upperMass_real mu
          (refinedOpenFamily hD mu O t ht0 ht1) U
      _ ≤ (mu (finiteUnion
          (fun q => wayAboveOpen hD
            (refinedAtomicPoint hD mu O t ht0 ht1 q)) K)).toReal := by
        apply ENNReal.toReal_mono
        · exact ne_top_of_le_ne_top ENNReal.one_ne_top
            (mu.value_le_one (finiteUnion
              (fun q => wayAboveOpen hD
                (refinedAtomicPoint hD mu O t ht0 ht1 q)) K))
        · exact mu.monotone
            (chosenPatternUpper_preimage_le hD mu O t ht0 ht1 K)
  calc
    (∑ q ∈ K, refinedAtomicWeight hD mu O t ht0 ht1 q) =
        t * (∑ q ∈ K, if P q then v q else 0) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro q hq
      change (if IsChosenRefinedPattern hD mu O t ht0 ht1 q then
          t * signatureVector mu
            (refinedOpenFamily hD mu O t ht0 ht1) q else 0) =
        t * (if IsChosenRefinedPattern hD mu O t ht0 ht1 q then
          signatureVector mu
            (refinedOpenFamily hD mu O t ht0 ht1) q else 0)
      by_cases hP : IsChosenRefinedPattern hD mu O t ht0 ht1 q
      · rw [if_pos hP, if_pos hP]
      · rw [if_neg hP, if_neg hP, mul_zero]
    _ = t * v.mass S := by
      rw [sum_finset_ite_eq_vector_mass]
    _ ≤ t * (mu (finiteUnion
        (fun q => wayAboveOpen hD
          (refinedAtomicPoint hD mu O t ht0 ht1 q)) K)).toReal :=
      mul_le_mul_of_nonneg_left hraw ht0

end ContinuousValuation
end FiniteValuationApproximable
