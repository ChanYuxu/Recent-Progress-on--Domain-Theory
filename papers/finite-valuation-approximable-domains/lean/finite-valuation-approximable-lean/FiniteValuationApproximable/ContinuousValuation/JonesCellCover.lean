import FiniteValuationApproximable.ContinuousValuation.JonesCells

/-!
# Finite covers of positive Boolean cells

For a positive Boolean signature cell and any factor `t < 1`, finitely many
way-above basic opens generated by points of that exact cell capture more
than `t` times its real valuation mass.  This is the corrected, valuation-only
form of the cellwise estimate in Jones's Lemma 5.3; no strict assertion is
made for a zero-mass cell.
-/

set_option autoImplicit false
set_option linter.unnecessarySimpa false

universe u v

namespace FiniteValuationApproximable
namespace ContinuousValuation

open Set
open AbramskyJung.Chapter2
open scoped ENNReal BigOperators

theorem exists_signatureCell_cover
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {I : Type v} [Fintype I] [DecidableEq I]
    (mu : VSub D) (O : I → ScottOpen D)
    (p : MembershipPattern I) (t : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t < 1)
    (hp : 0 < signatureVector mu O p) :
    ∃ s : Finset D,
      (∀ b ∈ s, membershipSignature O b = p) ∧
      t * signatureVector mu O p <
        (mu (crescentCoverOpen hD (signatureCellPunctured O p) s)).toReal -
          (mu (signatureCellPunctured O p)).toReal := by
  classical
  let A : ScottOpen D := signatureCellPrincipal O p
  let B : ScottOpen D := signatureCellPunctured O p
  let w : ℝ := signatureVector mu O p
  have hBA : B ≤ A := signatureCellPunctured_le_principal O p
  have hAfin : mu A ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.one_ne_top (mu.value_le_one A)
  have hB0 : 0 ≤ (mu B).toReal := ENNReal.toReal_nonneg
  have hw0 : 0 ≤ w := (signatureVector mu O).coeff_nonneg p
  have hwpos : 0 < w := hp
  have hwEq : w = (mu A).toReal - (mu B).toReal := by
    simpa [A, B, w] using signatureVector_eq_cellRealSub mu O p
  have hthreshold0 : 0 ≤ (mu B).toReal + t * w :=
    add_nonneg hB0 (mul_nonneg ht0 hw0)
  have hthreshold_lt :
      (mu B).toReal + t * w < (mu A).toReal := by
    rw [hwEq] at hwpos ⊢
    nlinarith
  have hc : ENNReal.ofReal ((mu B).toReal + t * w) < mu A :=
    (ENNReal.ofReal_lt_iff_lt_toReal hthreshold0 hAfin).2 hthreshold_lt
  rcases exists_crescentCover_value_gt hD mu hBA hc with
    ⟨s, hs, hvalue⟩
  refine ⟨s, ?_, ?_⟩
  · intro b hb
    exact (mem_signatureCell_crescent_iff O p b).mp (hs b hb)
  · have hcoverFin :
        mu (crescentCoverOpen hD B s) ≠ ⊤ :=
      ne_top_of_le_ne_top ENNReal.one_ne_top
        (mu.value_le_one (crescentCoverOpen hD B s))
    have hreal : (mu B).toReal + t * w <
        (mu (crescentCoverOpen hD B s)).toReal :=
      (ENNReal.ofReal_lt_iff_lt_toReal hthreshold0 hcoverFin).1 hvalue
    simpa [B, w] using (show
      t * w < (mu (crescentCoverOpen hD B s)).toReal - (mu B).toReal by
        linarith)

end ContinuousValuation
end FiniteValuationApproximable
