import FiniteValuationApproximable.ContinuousValuation.JonesFubini

/-!
# Way-above Scott opens used in Jones's continuity theorem

For a continuous domain, the sets `\{x | b \ll x\}` are Scott open and form
a basis of the Scott topology.  Jones's proof of continuity of the valuation
dcpo uses finite unions of precisely these opens.  This file proves those
facts directly from the order-theoretic definitions in `OrderTheory.lean`.
-/

set_option autoImplicit false
set_option linter.unnecessarySimpa false

universe u v

namespace FiniteValuationApproximable
namespace ContinuousValuation

open Set
open AbramskyJung.Chapter2

/-- The basic Scott open above `b` in the way-below relation. -/
def wayAboveOpen
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D) (b : D) :
    ScottOpen D where
  carrier := {x | b ≪ x}
  isScottOpen := by
    constructor
    · intro x y hxy hbx
      exact prop_2_2_2_2 le_rfl hbx hxy
    · intro A s hA hs hbs
      rcases wayBelow_interpolation hD hbs with ⟨c, hbc, hcs⟩
      rcases hcs hA hs le_rfl with ⟨a, haA, hca⟩
      exact ⟨a, haA, prop_2_2_2_2 le_rfl hbc hca⟩

@[simp]
theorem mem_wayAboveOpen_iff
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D) (b x : D) :
    x ∈ wayAboveOpen hD b ↔ b ≪ x :=
  Iff.rfl

/-- A way-above basic open is contained in every upper set containing its
generating point. -/
theorem wayAboveOpen_le_of_mem
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    {b : D} {U : ScottOpen D} (hbU : b ∈ U) :
    wayAboveOpen hD b ≤ U := by
  intro x hbx
  exact U.upper (prop_2_2_2_1 hbx) hbU

/-- Every point of a Scott open lies in a way-above basic open generated by
a point of the same Scott open. -/
theorem exists_wayAboveOpen_mem
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    (U : ScottOpen D) {x : D} (hxU : x ∈ U) :
    ∃ b ∈ U, x ∈ wayAboveOpen hD b := by
  have hdir := continuous_wayBelowLower_directed hD x
  have hsup := continuous_wayBelowLower_isSup hD x
  rcases U.inaccessible hdir hsup hxU with ⟨b, hbx, hbU⟩
  exact ⟨b, hbU, hbx⟩

/-- The way-above basic opens generated by points of `U` have supremum `U`.
This is the source statement that the `V_b` generate the Scott topology. -/
theorem wayAboveOpen_isSup
    {D : Type u} [Preorder D]
    (hD : AbramskyJung.Chapter2.IsContinuousDomain D)
    (U : ScottOpen D) :
    IsSup (wayAboveOpen hD '' (U : Set D)) U := by
  constructor
  · rintro V ⟨b, hbU, rfl⟩
    exact wayAboveOpen_le_of_mem hD hbU
  · intro W hW x hxU
    rcases exists_wayAboveOpen_mem hD U hxU with ⟨b, hbU, hxb⟩
    exact hW ⟨b, hbU, rfl⟩ hxb

/-- Finite union of a family of Scott opens. -/
def finiteUnion
    {D : Type u} [Preorder D] {I : Type v}
    (O : I → ScottOpen D) (s : Finset I) : ScottOpen D :=
  ScottOpen.sUnion (O '' (s : Set I))

@[simp]
theorem mem_finiteUnion_iff
    {D : Type u} [Preorder D] {I : Type v}
    (O : I → ScottOpen D) (s : Finset I) (x : D) :
    x ∈ finiteUnion O s ↔ ∃ i ∈ s, x ∈ O i := by
  constructor
  · intro hx
    rcases ScottOpen.mem_sUnion_iff.mp hx with ⟨V, ⟨i, hi, rfl⟩, hxi⟩
    exact ⟨i, hi, hxi⟩
  · rintro ⟨i, hi, hxi⟩
    exact ScottOpen.mem_sUnion_iff.mpr ⟨O i, ⟨i, hi, rfl⟩, hxi⟩

theorem finiteUnion_mono
    {D : Type u} [Preorder D] {I : Type v}
    (O : I → ScottOpen D) {s t : Finset I} (hst : s ⊆ t) :
    finiteUnion O s ≤ finiteUnion O t := by
  intro x hx
  rcases (mem_finiteUnion_iff O s x).mp hx with ⟨i, hi, hxi⟩
  exact (mem_finiteUnion_iff O t x).mpr ⟨i, hst hi, hxi⟩

@[simp]
theorem finiteUnion_empty
    {D : Type u} [Preorder D] {I : Type v}
    (O : I → ScottOpen D) :
    finiteUnion O ∅ = (ScottOpen.empty : ScottOpen D) := by
  apply ScottOpen.ext
  ext x
  simp [mem_finiteUnion_iff]

@[simp]
theorem finiteUnion_insert
    {D : Type u} [Preorder D] {I : Type v} [DecidableEq I]
    (O : I → ScottOpen D) (i : I) (s : Finset I) :
    finiteUnion O (insert i s) = ScottOpen.union (O i) (finiteUnion O s) := by
  apply ScottOpen.ext
  ext x
  simp [mem_finiteUnion_iff]

end ContinuousValuation
end FiniteValuationApproximable
