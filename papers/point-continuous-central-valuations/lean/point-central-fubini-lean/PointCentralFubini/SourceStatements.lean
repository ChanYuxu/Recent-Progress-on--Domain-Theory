import PointCentralFubini.Integration
import Mathlib.Topology.Sets.VietorisTopology
import Mathlib.MeasureTheory.Measure.Typeclasses.Finite
import Mathlib.MeasureTheory.Integral.Lebesgue.Add
import Mathlib.Topology.Semicontinuity.Basic

/-!
Exact, proposition-valued statement types from Section 4. A statement type is not
proof evidence. `source-map.json` records which are now inhabited by proved theorems.
These are kept in their intended stable module while proof work proceeds.
-/
set_option autoImplicit false
open Set Topology TopologicalSpace MeasureTheory Filter
open scoped ENNReal
universe u v w
namespace PointCentralFubini

/-- Finite tau-smooth BOREL measure; no Radon or Hausdorff assumption is added. -/
structure TauMeasure (X : Type u) [TopologicalSpace X] where
  measure : @Measure X (borel X)
  finite : measure univ ≠ ⊤
  directed_opens : ScottContinuous (fun U : Opens X => measure (U : Set X))

namespace TauMeasure
variable {X : Type u} [TopologicalSpace X]
def toValuation (m : TauMeasure X) : Valuation X where
  mass U := m.measure (U : Set X)
  strict := measure_empty
  modular U V := by
    letI : MeasurableSpace X := borel X
    letI : BorelSpace X := ⟨rfl⟩
    exact (measure_union_add_inter (U : Set X) V.isOpen.measurableSet).symm
  continuous := m.directed_opens
@[simp] theorem toValuation_apply (m : TauMeasure X) (U : Opens X) :
    m.toValuation U = m.measure (U : Set X) := rfl

theorem toValuation_finite (m : TauMeasure X) : m.toValuation.Finite := m.finite
end TauMeasure

/-- Equation `eq:countable-inner-approximation`, including the empty supremum. -/
def InnerSkeleton {X : Type u} [TopologicalSpace X]
    (m : TauMeasure X) (C : Set (Opens X)) : Prop :=
  C.Countable ∧ ∀ U : Opens X,
    m.measure (U : Set X) = ⨆ (V : Opens X) (_ : V ∈ C) (_ : V ≤ U), m.measure (V : Set X)

/-- Source lemma 4.1 (`lem:scott-fatou`). The liminf is expanded to tail infima. -/
def ScottFatouStatement : Prop :=
  ∀ (P : Type u) [PartialOrder P], IsDcpo P →
    ∀ (ξ : DValuation P) (h : P → ℝ≥0∞) (f : ℕ → P → ℝ≥0∞),
      ScottContinuous h → (∀ n, ScottContinuous (f n)) →
      (∀ p, h p ≤ ⨆ N : ℕ, ⨅ n ≥ N, f n p) →
      integral ξ (fun p => h (WithScott.ofScott p)) ≤
        ⨆ N : ℕ, ⨅ n ≥ N, integral ξ (fun p => f n (WithScott.ofScott p))

def MeasureSourceIncidenceStatement : Prop :=
  ∀ (X : Type u) [TopologicalSpace X] [FirstCountableTopology X]
    (m : TauMeasure X) (C : Set (Opens X)), InnerSkeleton m C →
    ∀ η : DValuation (Opens X), η.Finite →
      IsLSC (fun x => η (pointOpen x)) ∧
      integral η (fun U => m.measure ((WithScott.ofScott U : Opens X) : Set X)) =
        @lintegral X (borel X) m.measure
          (fun x => η (pointOpen x))

/-- Source lemma 4.3 (`lem:full-outer-trace`): A is not required to be Borel. -/
def FullOuterTraceStatement : Prop :=
  ∀ (E : Type u) [TopologicalSpace E] (M : TauMeasure E) (A : Set E),
    (∀ B : Set E, MeasurableSet[borel E] B → B ⊆ Aᶜ → M.measure B = 0) →
    ∃ m : TauMeasure A,
      ∀ B : Set E, MeasurableSet[borel E] B →
        m.measure (Subtype.val ⁻¹' B) = M.measure B

/-- The concrete Sorgenfrey line, with intervals [a,b) as generating opens. -/
def Sorgenfrey := ℝ
noncomputable instance : LinearOrder Sorgenfrey := inferInstanceAs (LinearOrder ℝ)
instance : TopologicalSpace Sorgenfrey :=
  TopologicalSpace.generateFrom {U | ∃ a b : ℝ, a < b ∧ U = Ico a b}

/-- D is the nonempty COMPACT subsets of the Sorgenfrey line, with reverse
inclusion. Compactness refers to the Sorgenfrey topology. -/
abbrev SorgenfreySmyth := OrderDual (NonemptyCompacts Sorgenfrey)

/-- X is the same compact-set carrier with the FULL Vietoris topology. -/
abbrev SorgenfreyVietoris := NonemptyCompacts Sorgenfrey

/-- The continuous map in the final argument, identity on compact sets. -/
def vietorisToScott (K : SorgenfreyVietoris) : WithScott SorgenfreySmyth :=
  WithScott.toScott (OrderDual.toDual K)

def FullVietorisLiftStatement : Prop :=
  ∀ μ : DValuation SorgenfreySmyth, μ.Finite →
    ∃ m : TauMeasure SorgenfreyVietoris,
      ∀ U : ScottOpens SorgenfreySmyth,
        m.measure (vietorisToScott ⁻¹' (U : Set (WithScott SorgenfreySmyth))) = μ U

/-- A concrete countable Boolean algebra generated by rational clopen rays. -/
inductive RationalClopen : Set Sorgenfrey → Prop
  | ray (q : ℚ) : RationalClopen {x | (x : ℝ) < (q : ℝ)}
  | empty : RationalClopen ∅
  | compl {C : Set Sorgenfrey} : RationalClopen C → RationalClopen Cᶜ
  | union {C D : Set Sorgenfrey} : RationalClopen C → RationalClopen D → RationalClopen (C ∪ D)

/-- The isolated `*` value is the right summand, not a numerical sentinel. -/
abbrev ObservationCodomain := Sorgenfrey ⊕ Unit

/-- The specified extrema, with existence left as a separate obligation. -/
def IsLowerObservation (C : Set Sorgenfrey) (K : SorgenfreyVietoris)
    (z : ObservationCodomain) : Prop :=
  match z with
  | .inl a => a ∈ (K : Set Sorgenfrey) ∩ C ∧
      ∀ b ∈ (K : Set Sorgenfrey) ∩ C, (a : ℝ) ≤ (b : ℝ)
  | .inr _ => (K : Set Sorgenfrey) ∩ C = ∅

def IsUpperObservation (C : Set Sorgenfrey) (K : SorgenfreyVietoris)
    (z : ObservationCodomain) : Prop :=
  match z with
  | .inl a => a ∈ (K : Set Sorgenfrey) ∩ C ∧
      ∀ b ∈ (K : Set Sorgenfrey) ∩ C, (b : ℝ) ≤ (a : ℝ)
  | .inr _ => (K : Set Sorgenfrey) ∩ C = ∅

def ExtremalObservablesStatement : Prop :=
  ∃ (lower upper : {C : Set Sorgenfrey // RationalClopen C} →
      SorgenfreyVietoris → ObservationCodomain),
    (∀ (C : {C : Set Sorgenfrey // RationalClopen C}) K, IsLowerObservation C.val K (lower C K)) ∧
    (∀ (C : {C : Set Sorgenfrey // RationalClopen C}) K, IsUpperObservation C.val K (upper C K)) ∧
    (∀ C, Continuous (lower C) ∧ Continuous (upper C)) ∧
    (inferInstance : TopologicalSpace SorgenfreyVietoris) =
      (⨅ C, TopologicalSpace.induced (lower C) inferInstance) ⊓
        (⨅ C, TopologicalSpace.induced (upper C) inferInstance) ∧
    FirstCountableTopology SorgenfreyVietoris

def SorgenfreyInnerSkeletonStatement : Prop :=
  ∀ m : TauMeasure SorgenfreyVietoris,
    ∃ C : Set (Opens SorgenfreyVietoris), InnerSkeleton m C

def SorgenfreyFubiniStatement : Prop := FubiniObject.{0,v} SorgenfreySmyth

end PointCentralFubini
