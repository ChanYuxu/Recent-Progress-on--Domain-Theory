theorem second_countable_fubini (P : Type u) [PartialOrder P] (_hP : IsDcpo P)
    [SecondCountableTopology (WithScott P)] : FubiniObject.{u,v} P :=
  coconsonant_descent P (deBrechtKawai_coconsonant (WithScott P))
