import PointCentralFubini.Central
set_option autoImplicit false
open Set Topology TopologicalSpace
open scoped ENNReal
universe u v
namespace PointCentralFubini

/-- The source's weak topology, generated by complements of principal lower sets. -/
@[implicit_reducible] def weakTopology (X : Type u) [TopologicalSpace X] : TopologicalSpace (Opens X) :=
  TopologicalSpace.generateFrom {H | ∃ V : Opens X, H = {U | ¬ U ≤ V}}

/-- Source Section 5: the subbasic hitting set of the closure of x is M_x. -/
theorem weak_pointOpen {X : Type u} [TopologicalSpace X] (x : X) :
    @IsOpen (Opens X) (weakTopology X) {U | x ∈ U} := by
  let V : Opens X := ⟨(closure ({x} : Set X))ᶜ,isClosed_closure.isOpen_compl⟩
  have ho : @IsOpen (Opens X) (weakTopology X) {U | ¬ U ≤ V} :=
    isOpen_generateFrom_of_mem ⟨V,rfl⟩
  convert ho using 1
  ext U
  constructor
  · intro hx hUV
    exact hUV hx (subset_closure (mem_singleton x))
  · intro hnot
    by_contra hx
    have hc : closure ({x} : Set X) ⊆ (U : Set X)ᶜ :=
      closure_minimal (singleton_subset_iff.mpr hx) U.isOpen.isClosed_compl
    exact hnot (fun y hy hycl => hc hycl hy)

/-- The weak and point topologies coincide, as proved in the supplied Section 5. -/
theorem weakTopology_eq_pointTopology (X : Type u) [TopologicalSpace X] :
    weakTopology X = pointTopology X := by
  classical
  apply le_antisymm
  · intro H hH
    letI : TopologicalSpace (Opens X) := weakTopology X
    apply isOpen_iff_mem_nhds.mpr
    intro U hU
    obtain ⟨F,hFU,hFH⟩ := hH U hU
    have hW : IsOpen {V : Opens X | (↑F : Set X) ⊆ V} := by
      have ho := F.finite_toSet.isOpen_biInter (fun x _ => weak_pointOpen x)
      convert ho using 1
      ext V; simp [Set.subset_def]
    exact Filter.mem_of_superset (hW.mem_nhds hFU) (fun V hV => hFH V hV)
  · apply le_generateFrom_iff_subset_isOpen.mpr
    rintro H ⟨V,rfl⟩ U hU
    obtain ⟨x,hxU,hxV⟩ := Set.not_subset.mp hU
    refine ⟨{x},by simpa,?_⟩
    intro W hW hWV
    exact hxV (hWV (hW (by simp)))

/-- The original weak-topology definition of co-consonance. -/
def CoConsonant (X : Type u) [TopologicalSpace X] : Prop :=
  weakTopology X = Topology.scott (Opens X) Set.univ

/-- Co-consonance implies point-continuity directly from continuity of mass. -/
theorem pointContinuous_of_coconsonant {X : Type u} [TopologicalSpace X]
    (hX : CoConsonant X) (μ : Valuation X) : PointContinuous μ := by
  change @Continuous (Opens X) (WithScott ℝ≥0∞) (pointTopology X) inferInstance
    (fun U => WithScott.toScott (μ U))
  rw [← weakTopology_eq_pointTopology X,hX]
  exact (scott_continuous_iff μ.mass).mp μ.continuous

